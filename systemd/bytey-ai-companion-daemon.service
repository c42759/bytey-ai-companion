[Unit]
Description=Bytey AI Companion Core Daemon
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/c42759/Git/pet/core-daemon
Environment=PYTHONPATH=/home/c42759/Git/pet/core-daemon
EnvironmentFile=-%h/.config/ai-pet/.env
EnvironmentFile=-%h/.config/bytey-ai-companion/.env
ExecStart=/usr/bin/python3 -m bytey_ai_companion.main
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
