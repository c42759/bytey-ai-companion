[Unit]
Description=Bytey AI Companion Core Daemon
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/bin/bytey-ai-companion-daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
