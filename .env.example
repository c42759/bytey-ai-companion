# Bytey AI Companion Secrets Template
# Copy to .env in the repository root or ~/.config/bytey-ai-companion/.env (legacy ~/.config/ai-pet/.env also supported)
# Alternatively, store keys via Settings UI (PUT /api/v1/secrets -> OS keyring).

# AI Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_LLM_API_KEY=

# Text-to-Speech (TTS)
ELEVENLABS_API_KEY=
KOKORO_API_KEY=

# Speech-to-Text (STT HTTP API)
STT_API_KEY=
